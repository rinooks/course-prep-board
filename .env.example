NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- 알림 메일 (서버 전용 비밀값: 절대 NEXT_PUBLIC_를 붙이지 않는다). 설정 방법: docs/알림-메일-설정.md ----------
# Firebase 서비스 계정 키 JSON 내용 전체 (또는 그 JSON을 base64로 바꾼 값)
FIREBASE_SERVICE_ACCOUNT=
# 알림 메일을 보내는 Gmail 주소
GMAIL_USER=
# 위 Gmail 계정의 앱 비밀번호 16자리 (구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
GMAIL_APP_PASSWORD=
# Vercel Cron 요청 확인용 무작위 값 (16자 이상)
CRON_SECRET=
# (선택) 메일 속 링크의 앱 주소. 비우면 https://edu-project-beta.vercel.app
APP_BASE_URL=
